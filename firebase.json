{
  "firestore": {
    "rules": "lib/firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
          { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(self), microphone=(), payment=(), usb=()" }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "python314",
      "ignore": [
        "venv",
        ".git",
        "__pycache__",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "test_*.py"
      ]
    }
  ],
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "parfumdex",
          "appId": "1:328422734733:android:ac6717b29077fabcb59bc4",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "parfumdex",
          "configurations": {
            "android": "1:328422734733:android:ac6717b29077fabcb59bc4",
            "ios": "1:328422734733:ios:337f3bd5ae2abe1cb59bc4",
            "web": "1:328422734733:web:7c5fd7833d6e7115b59bc4"
          }
        }
      }
    }
  }
}
