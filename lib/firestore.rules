rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Ayudantes ----------
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }

    // Obliga a que toda consulta de lista lleve .limit(n) con n <= max.
    function smallList(max) {
      return request.query.limit != null && request.query.limit <= max;
    }

    // Campo opcional: si viene y no es null, tiene que cumplir el tipo/rango.
    function optString(d, key, max) {
      return !(key in d) || d[key] == null || (d[key] is string && d[key].size() <= max);
    }
    function optNumber(d, key, min, max) {
      return !(key in d) || d[key] == null
        || (d[key] is number && d[key] >= min && d[key] <= max);
    }

    // ---------- Catálogo (solo lectura) ----------
    match /perfumes/{perfumeId} {
      allow get: if signedIn();
      // getPerfumesPage() pide páginas de 48 (PerfumesService.pageSize):
      // más de 50 por consulta no se puede pedir.
      allow list: if signedIn() && smallList(50);
      allow write: if false;
    }

    // Índice de búsqueda: solo get del documento, nunca listar.
    match /catalog/{docId} {
      allow get: if signedIn();
      allow list, write: if false;
    }

    // stores: sin bloque = denegado. Solo la lee la Cloud Function (Admin SDK).

    // ---------- Usernames ----------
    // Un usuario = un handle. El handle y el perfil se crean juntos y se
    // borran juntos (mismo batch), así nadie puede acaparar nombres.
    match /usernames/{handle} {
      allow create: if signedIn()
        && handle.matches('^[a-z0-9]{3,30}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        // El handle tiene que ser el username de MI perfil al terminar el
        // batch. Como el username del perfil no se puede cambiar, no se puede
        // reservar un segundo handle teniendo ya perfil.
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == handle;
      allow update: if false;
      // Solo se libera el handle si en el mismo batch se borra el perfil.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // ---------- Perfil ----------
    function validProfile(d) {
      return d.keys().hasOnly([
          'email', 'displayName', 'username', 'isPublic', 'createdAt',
          'genre', 'birthYear', 'scentPreference',
          'lastSearchLocation', 'lastSearchAt', 'lastSearchArea'])
        && d.displayName is string && d.displayName.size() <= 50
        && d.username is string && d.username.matches('^[a-z0-9]{3,30}$')
        && optString(d, 'email', 254)
        // Las fechas tienen que ser fechas: sin esto se podía guardar
        // cualquier cosa (hasta 1 MB de texto) en estos dos campos.
        && d.createdAt is timestamp
        && (!('lastSearchAt' in d) || d.lastSearchAt == null
            || d.lastSearchAt is timestamp)
        && (!('isPublic' in d) || d.isPublic is bool)
        && optString(d, 'genre', 40)
        && optString(d, 'scentPreference', 40)
        && optNumber(d, 'birthYear', 1900, 2100)
        && (!('lastSearchLocation' in d) || d.lastSearchLocation == null
            || d.lastSearchLocation is latlng)
        && optString(d, 'lastSearchArea', 100);
    }

    match /users/{userId} {
      allow get: if isUser(userId);
      allow list: if false;

      // Solo se crea el perfil si, en el mismo batch, se reserva el handle
      // a nombre del mismo usuario (getAfter mira el estado final).
      allow create: if isUser(userId)
        && validProfile(request.resource.data)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == request.auth.uid;

      // El username y la fecha de alta no se pueden cambiar editando el
      // perfil a mano.
      allow update: if isUser(userId)
        && validProfile(request.resource.data)
        && request.resource.data.username == resource.data.username
        && request.resource.data.createdAt == resource.data.createdAt;

      // Borrar el perfil obliga a liberar su handle en el mismo batch: no
      // pueden quedar handles reservados sin perfil.
      allow delete: if isUser(userId)
        && !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username));

      // ---------- Armario ----------
      function validVaultItem(d) {
        return d.keys().hasOnly([
            'perfumeId', 'perfumeName', 'brand', 'imageUrl',
            'capacityMl', 'remainingMl', 'purchasePrice', 'rating', 'addedAt',
            'userBottlePhoto'])
          && d.perfumeId is string && d.perfumeId.size() <= 100
          && optString(d, 'perfumeName', 200)
          && optString(d, 'brand', 100)
          && optString(d, 'imageUrl', 500)
          && optNumber(d, 'capacityMl', 1, 1000)       // Validators.maxCapacityMl
          && optNumber(d, 'remainingMl', 0, 1000)
          && optNumber(d, 'purchasePrice', 0, 2000)    // Validators.maxPurchasePrice
          && optNumber(d, 'rating', 0, 5)              // Validators.maxRating
          && d.addedAt is timestamp
          // Foto del frasco en Base64: opcional y por debajo de 300 000
          // caracteres (VaultService.maxPhotoLength). El documento admite 1 MB
          && (!('userBottlePhoto' in d)
              || (d.userBottlePhoto is string && d.userBottlePhoto.size() < 300000));
      }

      match /vault/{itemId} {
        // Sin smallList: count() no lleva limit. Son datos propios y acotados.
        allow read: if isUser(userId);

        // Límite del plan gratis (VaultService.freeLimit): un frasco nuevo
        // solo puede ocupar uno de 5 huecos con ID fijo (slot1..slot5). Como
        // no existen más IDs válidos, no se pueden crear más de 5, y no hace
        // falta contar documentos (contar en las reglas costaría lecturas).
        allow create: if isUser(userId)
          && itemId.matches('^slot[1-5]$')
          && validVaultItem(request.resource.data);

        // Editar no puede convertir un frasco en otro: el perfume y la fecha
        // de alta no cambian. Así un set() sobre un hueco ocupado se rechaza
        // en vez de machacar el frasco que había.
        allow update: if isUser(userId)
          && validVaultItem(request.resource.data)
          && request.resource.data.perfumeId == resource.data.perfumeId
          && request.resource.data.addedAt == resource.data.addedAt;

        allow delete: if isUser(userId);
      }
    }
  }
}
